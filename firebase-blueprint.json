{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["teacher", "student"] },
        "displayName": { "type": "string" },
        "nisn": { "type": "string" },
        "kelas": { "type": "string" }
      },
      "required": ["uid", "email", "role"]
    },
    "Assignment": {
      "title": "Assignment",
      "description": "Homework assignment",
      "type": "object",
      "properties": {
        "bab": { "type": "string" },
        "materi": { "type": "string" },
        "kelas": { "type": "string" },
        "description": { "type": "string" },
        "deadline": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "teacherId": { "type": "string" }
      },
      "required": ["bab", "materi", "kelas", "deadline", "teacherId"]
    },
    "Class": {
      "title": "Class",
      "description": "A school class",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "createdAt"]
    },
    "Submission": {
      "title": "Submission",
      "description": "Student homework submission",
      "type": "object",
      "properties": {
        "assignmentId": { "type": "string" },
        "studentId": { "type": "string" },
        "fileUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["submitted", "graded"] },
        "grade": { "type": "number" },
        "feedback": { "type": "string" },
        "submittedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["assignmentId", "studentId", "status"]
    },
    "Chapter": {
      "title": "Chapter",
      "description": "Learning chapter",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "createdAt"]
    },
    "Material": {
      "title": "Material",
      "description": "Learning material/materi ajar",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "subject": { "type": "string" },
        "bab": { "type": "string" },
        "driveUrl": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "subject", "bab", "driveUrl"]
    },
    "MaterialProgress": {
      "title": "MaterialProgress",
      "description": "Student progress on a specific material",
      "type": "object",
      "properties": {
        "materialId": { "type": "string" },
        "studentId": { "type": "string" },
        "status": { "type": "string", "enum": ["Belum Dimulai", "Sedang Dipelajari", "Selesai"] },
        "isFavorite": { "type": "boolean" },
        "lastAccessed": { "type": "string", "format": "date-time" }
      },
      "required": ["materialId", "studentId", "status"]
    },
    "FinalGrade": {
      "title": "FinalGrade",
      "description": "Persisted grade after submission is deleted",
      "type": "object",
      "properties": {
        "assignmentId": { "type": "string" },
        "studentId": { "type": "string" },
        "nisn": { "type": "string" },
        "nilai": { "type": "number" },
        "gradedAt": { "type": "string", "format": "date-time" },
        "hiddenByStudents": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["assignmentId", "studentId", "nisn", "nilai", "gradedAt"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Dynamic online CBT exam created by teacher with AI assistance",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "subject": { "type": "string" },
        "kelasRef": { "type": "string" },
        "token": { "type": "string" },
        "duration": { "type": "number" },
        "kkm": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "questions": {
          "type": "array",
          "items": { "type": "object" }
        }
      },
      "required": ["id", "title", "subject", "kelasRef", "token", "duration", "kkm", "questions"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Chat message between student and teacher regarding an assignment",
      "type": "object",
      "properties": {
        "assignmentId": { "type": "string" },
        "assignmentMateri": { "type": "string" },
        "studentId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentClass": { "type": "string" },
        "senderId": { "type": "string" },
        "senderRole": { "type": "string" },
        "text": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["assignmentId", "studentId", "studentName", "studentClass", "senderId", "senderRole", "text"]
    },
    "GradingRubric": {
      "title": "GradingRubric",
      "description": "Grading rubric percentages for final report card (Nilai Rapor)",
      "type": "object",
      "properties": {
        "kehadiran": { "type": "number" },
        "tugas": { "type": "number" },
        "uts": { "type": "number" },
        "uas": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["kehadiran", "tugas", "uts", "uas"]
    },
    "AiChatLog": {
      "title": "AiChatLog",
      "description": "Log of student interactions with Si Pinter AI assistant",
      "type": "object",
      "properties": {
        "studentName": { "type": "string" },
        "questionText": { "type": "string" },
        "durationMs": { "type": "number" },
        "flagged": { "type": "boolean" },
        "flaggedWord": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["studentName", "questionText", "durationMs", "timestamp"]
    },
    "AiViolation": {
      "title": "AiViolation",
      "description": "Log of profanity/digital ethics violations in Si Pinter chat",
      "type": "object",
      "properties": {
        "studentName": { "type": "string" },
        "questionText": { "type": "string" },
        "flaggedWord": { "type": "string" },
        "status": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "resolvedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["studentName", "questionText", "flaggedWord", "status", "timestamp"]
    },
    "ExamSession": {
      "title": "ExamSession",
      "description": "Real-time live proctoring session status for an active CBT exam",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "examId": { "type": "string" },
        "examTitle": { "type": "string" },
        "nisn": { "type": "string" },
        "studentName": { "type": "string" },
        "kelas": { "type": "string" },
        "status": { "type": "string", "enum": ["mengerjakan", "selesai", "melanggar"] },
        "answeredCount": { "type": "number" },
        "totalQuestions": { "type": "number" },
        "currentQuestion": { "type": "number" },
        "violationCount": { "type": "number" },
        "lastViolationReason": { "type": "string" },
        "startedAt": { "type": "string", "format": "date-time" },
        "lastActiveAt": { "type": "string", "format": "date-time" },
        "finishedAt": { "type": "string", "format": "date-time" },
        "score": { "type": "number" }
      },
      "required": ["examId", "nisn", "status", "answeredCount", "totalQuestions"]
    }
  },
  "firestore": {
    "config/{configId}": {
      "schema": "GradingRubric",
      "description": "Configuration collection including grading rubric"
    },
    "users/{uid}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "assignments/{assignmentId}": {
      "schema": "Assignment",
      "description": "Assignments collection"
    },
    "assignments/{assignmentId}/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Submissions for assignment"
    },
    "studentsByNisn/{nisn}": {
      "schema": "User",
      "description": "Mapping from NISN to student"
    },
    "classes/{classId}": {
      "schema": "Class",
      "description": "Classes registered by the teacher"
    },
    "chapters/{chapterId}": {
      "schema": "Chapter",
      "description": "Chapters created by the teacher"
    },
    "final_grades/{gradeId}": {
      "schema": "FinalGrade",
      "description": "Persisted grades collection"
    },
    "exams/{examId}": {
      "schema": "Exam",
      "description": "Dynamic exams created by the teacher"
    },
    "exam_sessions/{sessionId}": {
      "schema": "ExamSession",
      "description": "Real-time CBT exam proctoring sessions"
    },
    "materials/{materialId}": {
      "schema": "Material",
      "description": "Learning materials collection"
    },
    "material_progress/{progressId}": {
      "schema": "MaterialProgress",
      "description": "Student progress tracking for materials"
    },
    "assignment_chats/{chatMessageId}": {
      "schema": "ChatMessage",
      "description": "Chat messages between students and teachers about assignments"
    },
    "aiChatLogs/{logId}": {
      "schema": "AiChatLog",
      "description": "Logs of Si Pinter AI chat questions and response durations"
    },
    "aiViolations/{violationId}": {
      "schema": "AiViolation",
      "description": "Logs of detected digital ethics violations in Si Pinter AI chat"
    }
  }
}
